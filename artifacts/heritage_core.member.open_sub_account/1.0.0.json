{
  "schema": "cua.capability/v1",
  "id": "heritage_core.member.open_sub_account",
  "version": "1.0.0",
  "status": "draft",
  "title": "Open a new sub-account for a member",
  "description": "Open a new share sub-account (holiday club, vacation club or extra savings) for a member with an initial deposit, and return the confirmation number. IRREVERSIBLE: creates the account and posts the deposit.",
  "app": {
    "product": "heritage_core",
    "versions": ">=4.2,<5",
    "surface": "legacy_web",
    "entry": "/",
    "requires_auth": true
  },
  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "description": "Six-digit member number.",
      "required": true,
      "pattern": "^\\d{6}$",
      "classification": "pii"
    },
    {
      "name": "share_type",
      "type": "enum",
      "description": "Share type of the new sub-account.",
      "required": true,
      "enum": [
        "HOLIDAY CLUB",
        "VACATION CLUB",
        "EXTRA SAVINGS"
      ],
      "classification": "internal"
    },
    {
      "name": "nickname",
      "type": "string",
      "description": "Nickname shown on statements.",
      "required": true,
      "pattern": "^[A-Za-z0-9 ]{1,20}$",
      "classification": "internal"
    },
    {
      "name": "initial_deposit",
      "type": "money",
      "description": "Initial deposit amount, 5.00 to 10000.00.",
      "required": true,
      "classification": "internal"
    }
  ],
  "outputs": [
    {
      "name": "confirmation_number",
      "type": "string",
      "description": "Confirmation number of the new sub-account",
      "classification": "internal",
      "nullable": false
    }
  ],
  "risk": "irreversible",
